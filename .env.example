# ─── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/projectflow
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ─── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth ───────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Storage (Cloudflare R2) ────────────────────────────────
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET=projectflow-files
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# ─── Email (Resend) ─────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=noreply@projectflow.app

# ─── Monitoring ─────────────────────────────────────────────
SENTRY_DSN=https://xxxx@sentry.io/xxxx
LOGTAIL_TOKEN=your-logtail-token

# ─── App ────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# ─── Frontend (Next.js public) ──────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SENTRY_DSN=https://xxxx@sentry.io/xxxx
NEXT_PUBLIC_APP_URL=http://localhost:3000
